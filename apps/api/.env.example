# PostgreSQL connection string (Neon in production — see docs/ARCHITECTURE.md)
DATABASE_URL="postgresql://user:password@localhost:5432/toastcrumb?schema=public"

# API
PORT=4000
# Comma-separated origins allowed to call the API (the web app in dev)
CORS_ORIGIN="http://localhost:3000"

# Auth (Story 7.1) — the API signs JWTs with this secret. The app refuses to
# boot if JWT_SECRET is missing or empty. Use a long random string in real envs.
JWT_SECRET="replace-with-a-long-random-string"
JWT_EXPIRATION="7d"

# Google OAuth (Story 7.2). The app fails to boot if CLIENT_ID/SECRET are unset
# (any non-empty placeholder is enough to start; real creds are only needed to
# complete a live sign-in). CALLBACK_URL / WEB_APP_URL have code defaults.
GOOGLE_CLIENT_ID="replace-with-google-oauth-client-id"
GOOGLE_CLIENT_SECRET="replace-with-google-oauth-client-secret"
GOOGLE_CALLBACK_URL="http://localhost:4000/api/auth/google/callback"
WEB_APP_URL="http://localhost:3000"
